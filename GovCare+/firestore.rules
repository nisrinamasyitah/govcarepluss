rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── users/{userId} ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get:    if isOwner(userId) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isOwner(userId) && !('password' in request.resource.data);
      allow update: if isOwner(userId) && !('password' in request.resource.data);
      allow delete: if false;
    }

    // ── complaints/{complaintId} ───────────────────────────────────────────────
    match /complaints/{complaintId} {
      allow create: if isAuth() && request.resource.data.citizenId == request.auth.uid;
      allow get:    if isAuth() && (resource.data.citizenId == request.auth.uid || isAdmin());
      allow list:   if isAdmin() || (isAuth() && resource.data.citizenId == request.auth.uid);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ── admins/{adminId} ───────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read:  if isOwner(adminId);
      allow write: if false;
    }

    // ── activityLogs/{logId} ──────────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow get:    if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list:   if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // ── faqs/{faqId} ──────────────────────────────────────────────────────────
    // Collection name is 'faqs' (plural) — matches AdminFAQSection & FAQPage code.
    // Anyone (even unauthenticated) can read published FAQs.
    // Only admins can write.
    match /faqs/{faqId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
